# ======================
# Django
# ======================
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=

# ======================
# Database
# DB_URL is the full PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
# Used by development and production settings.
# ======================
DB_URL=

# ======================
# Redis / Celery
# REDIS_URL is a convenience fallback for local development.
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND take precedence in all environments.
# Production requires CELERY_BROKER_URL (and optionally CELERY_RESULT_BACKEND).
# ======================
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ======================
# Email
# ======================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=<your-app-password>
DEFAULT_FROM_EMAIL=PulseDesk <your-email@gmail.com>

# ======================
# Frontend
# ======================
FRONTEND_URL=http://localhost:5173
